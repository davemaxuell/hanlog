# HMAC signing key: at least 32 characters; required in production.
SESSION_SECRET=
# Postgres URL; omitted uses PGlite.
DATABASE_URL=
# Alternative Postgres URL.
POSTGRES_URL=
# Optional local PGlite persistence directory.
PGLITE_DIR=
# Supabase storage project URL.
SUPABASE_URL=
# Supabase server-only storage secret.
SUPABASE_SECRET_KEY=
# Alternative Supabase server-only storage secret.
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket name; default recordings.
MEDIA_BUCKET=
# Optional local media directory; default .data/media.
MEDIA_DIR=
# OpenAI server key; omitted uses demo scoring.
OPENAI_API_KEY=
# Optional override: mock or openai.
SCORING_PROVIDER=
# Default gpt-audio-1.5.
OPENAI_SCORING_MODEL=
# Scoring calls per user per Korea-time day; default 30.
USER_DAILY_ATTEMPTS=
# Scoring calls per address per Korea-time day; default 600.
IP_DAILY_ATTEMPTS=
# Global scoring calls per Korea-time day; default 1500.
GLOBAL_DAILY_ATTEMPTS=
# New profiles per address per Korea-time day; default 200.
IP_DAILY_SESSIONS=
# Recording retention in days; default 14.
RETENTION_DAYS=
# Cleanup route bearer secret; required in production.
CRON_SECRET=
