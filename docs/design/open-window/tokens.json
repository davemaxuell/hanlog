{
  "name": "Open Window",
  "version": "0.4-sky-buttercream",
  "date": "2026-11-15",
  "status": "Original proposed design direction (Sky, Buttercream & Berry palette); not extracted Setlog tokens",
  "purpose": "Bright pastel sky, buttercream, and berry visual rules; product information architecture uncommitted",
  "colors": {
    "canvas": "#D2F6FC",
    "surface": "#FFFEF9",
    "ink": "#1E2436",
    "textSecondary": "#4A566D",
    "action": "#FC7CAC",
    "actionHover": "#F7659D",
    "actionStroke": "#B02D63",
    "actionSoft": "#FCE6EF",
    "buttercream": "#FCFCC6",
    "skyStar": "#7CE4FC",
    "blushStar": "#FCC4D8",
    "dividerDecorative": "#A8D3DF",
    "controlBorder": "#5E7B8C",
    "errorInk": "#A32029",
    "errorSurface": "#FFF0EE"
  },
  "spacing": [
    4,
    8,
    12,
    16,
    24,
    32,
    48
  ],
  "layout": {
    "phoneGutter": 20,
    "narrowGutter": 16,
    "wideMargin": [
      56,
      72
    ],
    "phoneMarkerRail": [
      28,
      36
    ],
    "desktopContentMax": 1120,
    "note": "Stack margin labels above content at narrow widths or large text settings."
  },
  "radius": {
    "field": 8,
    "button": 12,
    "media": 12,
    "sheet": 20,
    "badge": 6
