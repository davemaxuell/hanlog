    "minTarget": 48,
    "horizontalPadding": [
      18,
      24
    ],
    "focus": {
      "width": 3,
      "offset": 3,
      "color": "action"
    }
  },
  "typography": {
    "title": {
      "size": [
        30,
        34
      ],
      "lineHeight": [
        38,
        42
      ],
      "weight": 400,
      "fontStack": "Georgia, Batang, serif"
    },
    "section": {
      "size": 20,
      "lineHeight": 28,
      "weight": 600
    },
    "body": {
      "size": 16,
      "lineHeight": 24,
      "weight": 400,
      "fontStack": "Malgun Gothic, Segoe UI, sans-serif"
    },
    "control": {
      "size": 16,
      "lineHeight": 22,
      "weight": 600
    },
    "secondary": {
      "size": 13,
      "lineHeight": 20
    },
    "margin": {
      "size": 12,
      "lineHeight": 18
    },
    "note": "Local prototype fallbacks. Final Korean/English type pair requires review."
  },
  "motion": {
    "pressMs": 120,
    "selectionMs": 160,
    "panelMs": 220,
    "maxPanelTravelPx": 8,
    "reducedMotion": "Immediate state change or short fade; no travel."
  },
  "contrastCalculated": [
    {
      "foreground": "ink",
      "background": "canvas",
      "ratio": 13.47
    },
    {
      "foreground": "textSecondary",
      "background": "canvas",
      "ratio": 6.45
    },
    {
      "foreground": "ink",
      "background": "action",
      "ratio": 6.33
    },
    {
      "foreground": "surface",
      "background": "actionStroke",
      "ratio": 6.11
    },
    {
      "foreground": "ink",
      "background": "buttercream",
      "ratio": 14.61
    },
    {
      "foreground": "ink",
      "background": "skyStar",
      "ratio": 10.55
    },
    {
      "foreground": "ink",
      "background": "blushStar",
      "ratio": 10.31
    },
    {
      "foreground": "errorInk",
      "background": "errorSurface",
      "ratio": 6.78
    }
  ],
  "identityRules": [
    "A margin organizes labels and content.",
    "Use at most one active-section corner mark per view.",
    "Put captions and actions below media.",
    "Use labelled rectangular primary actions.",
    "A successful save is acknowledged by check, words, and marker fill.",
    "Do not reuse the reference app's branded artwork or signature component composition."
  ],
  "components": {
    "cornerMark": {
      "sizePx": 12,
      "strokePx": 2.5,
      "color": "actionStroke",
      "maxPerView": 1
    },
    "statusMarker": {
      "sizePx": 26,
      "radiusPx": 6,
      "idleBorder": "controlBorder",
      "savedFill": "actionStroke",
      "errorFill": "errorInk"
    },
    "personAvatar": {
      "sizePx": 28,
      "radius": "999px",
      "note": "Full circles reserved for people, capture controls, and progress indicators"
    },
    "captureSheet": {
      "radiusPx": 20,
      "fieldRadiusPx": 8,
      "fieldBorder": "controlBorder"
    },
    "specimens": [
      "daily-window",
      "inline-capture-acknowledgement",
      "shared-table-circle",
      "monthly-margin-archive"
    ]
